<!--
  Snippet to paste inside <system.webServer> in the site's IIS web.config, when the whole
  project lives in one folder (the site cannot point at public/). Requires the URL Rewrite module.

  - assets/... is served from public/assets/...
  - everything else (including app/, config/, tests/, .env, *.md) falls through to the root
    index.php, so no project file is exposed.
-->
<rewrite>
  <rules>
    <rule name="SQLWM assets already resolved" stopProcessing="true">
      <match url="^public/assets/" />
      <action type="None" />
    </rule>
    <rule name="SQLWM assets" stopProcessing="true">
      <match url="^assets/(.+)$" />
      <action type="Rewrite" url="public/assets/{R:1}" />
    </rule>
    <rule name="SQLWM index" stopProcessing="true">
      <match url="^index\.php$" />
      <action type="None" />
    </rule>
    <rule name="SQLWM front controller" stopProcessing="true">
      <match url=".*" />
      <action type="Rewrite" url="index.php" />
    </rule>
  </rules>
</rewrite>
