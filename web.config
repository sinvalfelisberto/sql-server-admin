<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for hosts where the site points at the project root (not public/).
  Requires the URL Rewrite module.

  - assets/... is served from public/assets/...
  - every other request goes to the root index.php, which boots public/index.php.
  Source of these rules: deploy/iis-rewrite.xml (keep both in sync).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SQLWM assets already resolved" stopProcessing="true">
          <match url="^public/assets/" />
          <action type="None" />
        </rule>
        <rule name="SQLWM assets" stopProcessing="true">
          <match url="^assets/(.+)$" />
          <action type="Rewrite" url="public/assets/{R:1}" />
        </rule>
        <rule name="SQLWM index" stopProcessing="true">
          <match url="^index\.php$" />
          <action type="None" />
        </rule>
        <rule name="SQLWM front controller" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
