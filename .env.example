# Copy to .env and adjust. All variables are optional.
SQLWM_PORT=8080
# SQLWM_DEFAULT_SERVER=mssql,1433
# Comma-separated list of allowed servers; empty = any.
# SQLWM_ALLOWED_SERVERS=mssql,1433
# SQLWM_ENCRYPT=true
# SQLWM_TRUST_SERVER_CERTIFICATE=true
# SQLWM_MAX_ROWS=10000
# SQLWM_EXPORT_MAX_ROWS=0
# Default CSV separator: ; , | or tab (users can change it on screen)
# SQLWM_CSV_SEPARATOR=;
# SQLWM_QUERY_TIMEOUT=120
# SQLWM_SESSION_TIMEOUT=3600
# Only for the "demo" profile (test SQL Server). REQUIRED for that profile, with no default value:
# set a strong password of your own in your .env (which is not versioned). Never put it in this file.
# MSSQL_SA_PASSWORD=
