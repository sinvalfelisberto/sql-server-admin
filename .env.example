# Copie para .env e ajuste. Todas as variáveis são opcionais.
SQLWM_PORT=8080
# SQLWM_DEFAULT_SERVER=mssql,1433
# Lista (separada por vírgula) de servidores permitidos; vazio = qualquer um.
# SQLWM_ALLOWED_SERVERS=mssql,1433
# SQLWM_ENCRYPT=true
# SQLWM_TRUST_SERVER_CERTIFICATE=true
# SQLWM_MAX_ROWS=10000
# SQLWM_EXPORT_MAX_ROWS=0
# SQLWM_QUERY_TIMEOUT=120
# SQLWM_SESSION_TIMEOUT=3600
# Só para o perfil "demo" (SQL Server de teste). OBRIGATÓRIA nesse perfil, sem valor padrão:
# defina uma senha forte própria no seu .env (que não é versionado). Nunca a coloque neste arquivo.
# MSSQL_SA_PASSWORD=
